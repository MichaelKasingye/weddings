{
  "name": "mark-and-mary-wedding",
  "private": true,
  "description": "Interactive wedding invitation for Mr. Mark Mukasa & Mary Busingye",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --minify",
