# Copy to .env.local (local) or set in Vercel → Project → Settings → Environment Variables.

# MongoDB: local server, or the MongoDB Atlas connection string in production
MONGODB_URI=mongodb://127.0.0.1:27017/wedding_invites

# The public address of the site, used in guest links and link previews (no trailing slash)
APP_URL=http://localhost:3000

# Username of the super admin; the password is set once at /setup
SUPER_ADMIN_USERNAME=Michael
# Required on Vercel: /setup asks for this code, so nobody else can claim the super admin first
SETUP_CODE=1234569

# Africa's Talking SMS (optional; SMS stays off until these are set)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# secret added to the delivery-report callback URL configured in Africa's Talking
AT_CALLBACK_KEY=

# 